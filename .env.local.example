# Copy to `.env.local` for Next.js.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional. Used as the email-confirm redirect origin and invite links.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Week 2 email reminders (Resend). Required to actually send mail.
# RESEND_API_KEY=re_xxxxxxxxx
# Optional from-address. Defaults to Moving Butler <beth.t@example.com>
# RESEND_FROM_EMAIL=Moving Butler <butler@YOUR_DOMAIN>

# Unattended daily cron (GET /api/cron/task-reminders). Not needed for the
# in-app "Email due reminders" owner button.
# CRON_SECRET=generate-a-long-random-string
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
